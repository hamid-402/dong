{
  "name": "dang-hamkari",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @dang/web dev",
    "dev:web": "pnpm --filter @dang/web dev",
    "dev:api": "pnpm --filter @dang/api dev",
    "dev:worker": "pnpm --filter @dang/worker dev",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "db:generate": "pnpm --filter @dang/db db:generate",
    "db:migrate": "pnpm --filter @dang/db db:migrate",
    "db:check": "pnpm --filter @dang/db db:check",
    "test": "pnpm --filter @dang/contracts test && pnpm --filter @dang/db test && pnpm --filter @dang/api test && pnpm --filter @dang/worker test && pnpm --filter @dang/observability test && pnpm --filter @dang/web test",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test:a11y": "pnpm --filter @dang/web test:a11y",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "views:line-budget": "node scripts/view-line-budget.mjs",
    "license:check": "node scripts/license-check.mjs",
    "test:coverage": "pnpm --filter @dang/contracts test:coverage-check",
    "test:e2e": "pnpm --filter @dang/web test:e2e",
    "smoke:health": "node scripts/smoke-health.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "dr:backup": "node scripts/dr/pg-backup.mjs",
    "dr:drill": "node scripts/dr/pg-restore-drill.mjs",
    "perf:k6": "k6 run perf/k6/golden-path.js",
    "chaos:local": "node scripts/chaos/local-failover.mjs",
    "canary:gate": "node scripts/deploy/canary-gate.mjs",
    "contract:live": "node scripts/contract/live-api.mjs",
    "security:attack-surface": "node scripts/security/attack-surface.mjs",
    "i18n:check": "node scripts/i18n-scaffold-check.mjs",
    "prepare": "husky",
    "dr:wal:archive": "node scripts/dr/wal-archive-continuous.mjs",
    "dr:wal:drill": "node scripts/dr/pitr-timed-drill.mjs",
    "dr:wal:dry-run": "node scripts/dr/pitr-timed-drill.mjs --dry-run && node --test scripts/dr/wal-rpo-logic.test.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.3.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
