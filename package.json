{
  "name": "dang-hamkari",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @dang/web dev",
    "dev:web": "pnpm --filter @dang/web dev",
    "dev:api": "pnpm --filter @dang/api dev",
    "dev:worker": "pnpm --filter @dang/worker dev",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "db:generate": "pnpm --filter @dang/db db:generate",
    "db:migrate": "pnpm --filter @dang/db db:migrate",
    "db:check": "pnpm --filter @dang/db db:check",
    "test": "pnpm --filter @dang/contracts test && pnpm --filter @dang/db test && pnpm --filter @dang/api test && pnpm --filter @dang/observability test && pnpm --filter @dang/web test",
    "test:coverage": "pnpm --filter @dang/contracts test:coverage-check",
    "test:e2e": "pnpm --filter @dang/web test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix --max-warnings=0 --no-warn-ignored"]
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
