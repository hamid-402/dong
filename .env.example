NODE_ENV=development

WEB_ORIGIN=http://localhost:3005
API_PORT=3006
API_BASE_URL=http://localhost:3006/api/v1

# After creating role/db (or using local bootstrap), point to Postgres.
# Compose maps Postgres to 5435; local Windows Postgres often uses 5432.
DATABASE_URL=postgresql://dang_migrator:CHANGE_ME@127.0.0.1:5432/dang
REDIS_URL=redis://localhost:6382

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=dang-private
S3_ACCESS_KEY=dang-local
S3_SECRET_KEY=dang-local-secret

# Dev actor headers (x-dang-subject). Must be false in production.
ALLOW_DEV_AUTH=true

# OIDC values are enabled after the identity provider is wired.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
