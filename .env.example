NODE_ENV=development

WEB_ORIGIN=http://localhost:3005
# Optional: comma-separated LAN/public origins for CORS when opening the app by IP
# WEB_EXTRA_ORIGINS=http://192.168.1.10:3005
API_PORT=3006
API_BASE_URL=http://localhost:3006/api/v1
# Same-origin BFF: colleagues on LAN must use /api/v1 (not http://localhost:3006/...)
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_ORIGIN=http://127.0.0.1:3006

# After creating role/db (or using local bootstrap), point to Postgres.
# Compose maps Postgres to 5435; local Windows Postgres often uses 5432.
DATABASE_URL=postgresql://dang_migrator:CHANGE_ME@127.0.0.1:5432/dang
REDIS_URL=redis://localhost:6382
# Compose Valkey maps host 6382→container 6379. Windows Redis (winget) often binds 6379 —
# if login/session/rate-limit looks "memory-only", align REDIS_URL with the real listen port.
# Hard-fail readiness when Postgres is required (production-like local):
# DANG_REQUIRE_POSTGRES=1
# Hard-fail readiness when Redis must be reachable:
# DANG_REQUIRE_REDIS=1
# With REQUIRE flags, /health/ready returns 503 and capabilities.readiness=degraded
# until ping succeeds (and IAM is postgres when REQUIRE_POSTGRES=1).

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=dang-private
S3_ACCESS_KEY=dang-local
S3_SECRET_KEY=dang-local-secret

# Dev actor headers (x-dang-subject). Must be false in production.
ALLOW_DEV_AUTH=true

# Cookie session for email/password auth (required in production)
SESSION_SECRET=dev-only-session-secret-change-me

# --- Email (live only when provider path is chosen) ---
# Preferred live: Resend (wins if both set)
# RESEND_API_KEY=
# SMTP plug-in (BOTH required):
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_TRANSPORT=smtp
# SMTP_FROM=دنگ همکاری <noreply@example.com>
# After set: restart API → capabilities.providers.email=smtp|resend, stubs.emailDelivery=false
# statement.ready emails send when live + member has a real email (still in-app notify always).

# --- Zarinpal plug-in (dormant until ZARINPAL_ENABLED=1) ---
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_ENABLED=0
# ZARINPAL_PRODUCTION=0
# Public HTTPS callback required when ZARINPAL_PRODUCTION=1 (not localhost):
# ZARINPAL_CALLBACK_URL=http://localhost:3006/api/v1/payments/zarinpal/callback
# migrate through 0064 for return_url redirect after pay.

# --- ClamAV (infra ready; dormant until CLAMAV_ENABLED=1) ---
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_ENABLED=0

# --- Optional HTTP OCR (dormant until OCR_ENABLED=1) ---
# OCR_HTTP_URL=http://127.0.0.1:8090/ocr
# OCR_ENABLED=0

# --- Dong 2.0 product flags ---
# Production: unset = OFF. Development/test: unset = ON (full local surface).
# Force all unset→off even in dev: DANG_PRODUCT_FLAGS_DEFAULT=0
# Force one off: ENABLE_ADDON_ACK=0
# ENABLE_ADDON_ACK=
# ENABLE_RECURRENCE_WORKER=
# ENABLE_DEBT_SIMPLIFY_API=
# ENABLE_BI_COMPARE=
# ENABLE_COST_CENTER=
# ENABLE_ALLOWANCE=
# ENABLE_EXPENSE_POLICY=
# ENABLE_APPROVAL_QUEUE=
# ENABLE_REIMBURSEMENT=
# ENABLE_CATEGORY_BUDGET=
# ENABLE_FX_RATES=1
# Optional HTTP JSON FX provider: { "rates": [{ "baseCurrency","quoteCurrency","rate","asOf" }] }
# FX_PROVIDER_URL=
# ENABLE_EXPENSE_IMPORT=
# ENABLE_WEEKLY_DIGEST=
# Workspace plan admin (G17 e2e + freemium). Dev unset=ON; set explicitly for CI:
ENABLE_WORKSPACE_PLANS=1
ENABLE_PLAN_ADMIN=1
# ENABLE_APPROVAL_STEPS=
# Four-eyes on high-value settlement confirm / expense approve (R10-25).
# ENABLE_MAKER_CHECKER=
# Require receipt / cash-ack / gateway evidence on settlement confirm:
# ENABLE_SETTLEMENT_EVIDENCE=1
# Optional threshold override (IRR minor) when workspace expense policy has no approvalThresholdMinor:
# MAKER_CHECKER_THRESHOLD_MINOR=
# Optional approval-queue SLA clock in hours (sets slaDueAt / slaBreached on queue items):
# MAKER_CHECKER_SLA_HOURS=24
# Optional dedicated AES-256 key for MFA TOTP secrets (64-char hex or 32-byte base64).
# If unset, key is derived via HKDF from SESSION_SECRET.
# TOTP_ENCRYPTION_KEY=
# During rotation, keep the previous key so existing ciphertext still decrypts:
# TOTP_ENCRYPTION_KEY_PREVIOUS=

# Local Key Vault master key (R10-06 depth) — base64 of exactly 32 bytes.
# When set (or non-prod .dang/master.key generated), capabilities.providers.secrets=local_vault_v1
# and providers.masterKeySource=env.
# DANG_MASTER_KEY=
# Optional previous master during rotation window:
# DANG_MASTER_KEY_PREVIOUS=
# Optional HashiCorp Vault HTTP master key (Phase 2.1).
# Default remains env/file (ADR). Set ENABLE_HTTP_VAULT_MASTER_KEY=1 to prefer HTTP;
# when enabled, fetch failures fail closed (vault stays sealed).
# ENABLE_HTTP_VAULT_MASTER_KEY=1
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_MASTER_KEY_PATH=secret/data/dang/master-key

# Worker→API recurrence/digest: set the same secret on API and worker.
# Requests are HMAC-signed (ts + workspaceId + actorUserId); bare token alone is not enough.
# DANG_API_INTERNAL_URL=http://127.0.0.1:3006
# DANG_INTERNAL_JOB_TOKEN=
# During token rotation, API may also accept the previous token:
# DANG_INTERNAL_JOB_TOKEN_PREVIOUS=

# --- Observability (R10-01) ---
# Default: local ALS spans in logs. Set DANG_TRACING=off to disable.
# DANG_TRACING=local_spans
# Optional collector: docker compose -f infra/compose.local.yml --profile observability up -d otel-collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=dang-api

# --- Analytics warehouse (R10-20) ---
# Optional physical replica / separate DB for analytics schema.
# Unset = co-located schema on DATABASE_URL (providers.analyticsWarehouse=postgres_etl).
# ANALYTICS_DATABASE_URL=postgresql://dang_runtime:CHANGE_ME@127.0.0.1:5432/dang_analytics

# --- Pen-test engagement (R10-22) ---
# prep_ready (default) | engaged | remediating | closed
# PENTEST_STATUS=prep_ready

# OIDC values are enabled after the identity provider is wired.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
