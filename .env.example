NODE_ENV=development

WEB_ORIGIN=http://localhost:3005
# Optional: comma-separated LAN/public origins for CORS when opening the app by IP
# WEB_EXTRA_ORIGINS=http://192.168.1.10:3005
API_PORT=3006
API_BASE_URL=http://localhost:3006/api/v1
# Same-origin BFF: colleagues on LAN must use /api/v1 (not http://localhost:3006/...)
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_ORIGIN=http://127.0.0.1:3006

# After creating role/db (or using local bootstrap), point to Postgres.
# Compose maps Postgres to 5435; local Windows Postgres often uses 5432.
DATABASE_URL=postgresql://dang_migrator:CHANGE_ME@127.0.0.1:5432/dang
REDIS_URL=redis://localhost:6382
# Compose Valkey maps 6382→6379. Windows Redis (winget) can also bind --port 6382.

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=dang-private
S3_ACCESS_KEY=dang-local
S3_SECRET_KEY=dang-local-secret

# Dev actor headers (x-dang-subject). Must be false in production.
ALLOW_DEV_AUTH=true

# Cookie session for email/password auth (required in production)
SESSION_SECRET=dev-only-session-secret-change-me

# --- Email (live only when provider path is chosen) ---
# Preferred live: Resend
# RESEND_API_KEY=
# SMTP infra (dormant until EMAIL_TRANSPORT=smtp):
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_TRANSPORT=smtp
# SMTP_FROM=دنگ همکاری <noreply@example.com>

# --- Zarinpal (infra ready; dormant until ZARINPAL_ENABLED=1) ---
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_ENABLED=0
# ZARINPAL_PRODUCTION=0
# ZARINPAL_CALLBACK_URL=http://localhost:3006/api/v1/payments/zarinpal/callback

# --- ClamAV (infra ready; dormant until CLAMAV_ENABLED=1) ---
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_ENABLED=0

# --- Optional HTTP OCR (dormant until OCR_ENABLED=1) ---
# OCR_HTTP_URL=http://127.0.0.1:8090/ocr
# OCR_ENABLED=0

# OIDC values are enabled after the identity provider is wired.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
